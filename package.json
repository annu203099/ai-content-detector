{
  "name": "@annapurna12/ai-detector",
  "version": "1.0.0",
  "description": "High-performance on-device multimodal AI content detector for text, vision, and C2PA provenance",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "ai-detector",
    "deepfake",
    "c2pa",
    "provenance",
    "content-credentials",
    "distilbert",
    "vision-transformer",
    "vit",
    "onnx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --test-timeout 30000",
    "serve": "node scripts/dev-server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.9.9",
    "@contentauth/c2pa-web": "^0.15.3",
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.74",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
