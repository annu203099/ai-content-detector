{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/docs/(.*)", "destination": "/docs.html" },
    { "source": "/playground", "destination": "/#demo-simulation" },
    { "source": "/public/css/(.*)", "destination": "/css/$1" },
    { "source": "/public/docs.html", "destination": "/docs.html" }
  ]
}
