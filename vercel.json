{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/docs", "destination": "/public/docs.html" },
    { "source": "/docs/(.*)", "destination": "/public/docs.html" },
    { "source": "/playground", "destination": "/public/playground.html" },
    { "source": "/public/(.*)", "destination": "/public/$1" },
    { "source": "/", "destination": "/index.html" }
  ]
}
